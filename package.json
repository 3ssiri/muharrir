  "scripts": {
    "copy-pdf-worker": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs', 'public/pdf.worker.min.mjs')\"",
    "dev": "npm run copy-pdf-worker && next dev",
    "build": "npm run copy-pdf-worker && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "record-demo": "node scripts/record-demo.js",
    "record-gif": "node scripts/record-gif-demo.js",
    "tauri": "tauri"
  },
