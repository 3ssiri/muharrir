{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Iterator",
  "version": "0.1.0",
  "identifier": "com.assiri.prompt-iterator",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prompt Iterator",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/3ssiri/muharrir/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1MTIxRjlBNDA2RUUyRjAKUldUdzRtNUFtaDhTeFdrWi9rbG5ETFFIcEhYeXlNL1lOQlB0SnNmemMzeG1vUGNPanA1c0hOcmsK"
    }
  }
}
